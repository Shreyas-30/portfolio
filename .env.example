# ─────────────────────────────────────────────────────────────
# Now-aggregator source credentials (all OPTIONAL).
# RSS + GitHub adapters work with NO keys. Social adapters are
# disabled stubs until you supply tokens here.
# ─────────────────────────────────────────────────────────────

# GitHub public activity (optional — raises rate limit from 60 to 5000/hr)
# Create at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_USERNAME=
GITHUB_TOKEN=

# Instagram Graph API (requires a Business/Creator account + Meta app)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# X / Twitter (paid API tier required)
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=
